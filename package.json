{
  "name": "@ofrusch/kita",
  "version": "0.2.0",
  "description": "A frontend ORM and reactive state management framework for Vue 3 — typed models, HTTP-backed stores, and a model-store registry inspired by Ember Data.",
  "keywords": [
    "vue",
    "vue3",
    "state-management",
    "store",
    "orm",
    "frontend-orm",
    "ember-data",
    "decorators",
    "stage-3-decorators",
    "reactive",
    "swr",
    "optimistic-updates"
  ],
  "license": "MIT",
  "author": "Owen Carpenter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofrusch/kita.git"
  },
  "bugs": {
    "url": "https://github.com/ofrusch/kita/issues"
  },
  "homepage": "https://github.com/ofrusch/kita#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "play": "pnpm --filter kita-playground dev",
    "docs:dev": "pnpm --filter kita-docs dev",
    "docs:build": "pnpm --filter kita-docs build",
    "docs:preview": "pnpm --filter kita-docs preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:types": "attw --pack .",
    "size": "size-limit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@vue/devtools-api": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@size-limit/preset-small-lib": "^12.1.0",
    "size-limit": "^12.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.4.1",
  "publishConfig": {
    "access": "public"
  }
}
