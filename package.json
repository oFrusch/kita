{
  "name": "@ofrusch/kita",
  "version": "0.3.0",
  "description": "A frontend ORM and reactive state management framework for Vue 3 — typed models, HTTP-backed stores, and a model-store registry inspired by Ember Data.",
  "keywords": [
    "vue",
    "vue3",
    "state-management",
    "store",
    "orm",
    "frontend-orm",
    "ember-data",
    "decorators",
    "stage-3-decorators",
    "reactive",
    "swr",
    "optimistic-updates"
  ],
  "license": "MIT",
  "author": "Owen Carpenter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofrusch/kita.git"
  },
  "bugs": {
    "url": "https://github.com/ofrusch/kita/issues"
  },
  "homepage": "https://github.com/ofrusch/kita#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "play": "pnpm --filter kita-playground dev",
    "docs:dev": "pnpm --filter kita-docs dev",
    "docs:build": "pnpm --filter kita-docs build",
    "docs:preview": "pnpm --filter kita-docs preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p bench/tsconfig.json",
    "typecheck:bench": "tsc -p bench/tsconfig.json",
    "check:types": "attw --pack .",
    "size": "size-limit",
    "lint": "oxlint src/ tests/",
    "lint:fix": "oxlint --fix src/ tests/",
    "format": "oxfmt src/ tests/",
    "format:check": "oxfmt --check src/ tests/",
    "prepublishOnly": "pnpm run build",
    "bench:build": "esbuild bench/harness/run-case.ts --bundle --format=esm --target=es2022 --platform=node --outfile=bench/.dist/run-case.mjs",
    "bench": "pnpm bench:build && node bench/harness/gate.mjs",
    "bench:update": "pnpm bench:build && node bench/harness/update-baseline.mjs"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@vue/devtools-api": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@size-limit/preset-small-lib": "^12.1.0",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "size-limit": "^12.1.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0",
  "publishConfig": {
    "access": "public"
  }
}
